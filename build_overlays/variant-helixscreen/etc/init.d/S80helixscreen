#!/bin/sh
#
# Start HelixScreen
#

HELIXSCREEN=/opt/helixscreen/bin/helix-screen
PID_FILE=/run/helixscreen.pid
NICENESS=10

# Writable state lives under /data (persistent overlay)
HELIX_DATA=/data/helixscreen
HELIX_CACHE_DIR=$HELIX_DATA/cache
HELIX_CONFIG_DIR=$HELIX_DATA/config
HELIX_LOG_DIR=$HELIX_DATA/log
HELIX_LOG=$HELIX_LOG_DIR/helixscreen.log

start() {
    # Backlight reset - dodge the LCD 1%/100% inversion bug that bites on boot
    backlight 0%
    backlight 75%

    # Writable state dirs on first boot
    mkdir -p "$HELIX_CACHE_DIR" "$HELIX_CONFIG_DIR" "$HELIX_LOG_DIR"

    start-stop-daemon -S -b -m -p $PID_FILE -N $NICENESS \
        -d /opt/helixscreen \
        --exec /bin/sh -- -c \
        "HELIX_CACHE_DIR=$HELIX_CACHE_DIR HELIX_CONFIG_DIR=$HELIX_CONFIG_DIR exec $HELIXSCREEN >>$HELIX_LOG 2>&1"
}

stop() {
    start-stop-daemon -K -q -p $PID_FILE
}

restart() {
    stop
    sleep 2
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
