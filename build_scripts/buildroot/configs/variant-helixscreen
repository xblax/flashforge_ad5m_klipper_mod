# HelixScreen variant of AD5M Klipper Mod

# Variant Overlays
BR2_ROOTFS_OVERLAY="../../build_overlays/common ../../build_overlays/variant-helixscreen"

# wpa-supplicant (WiFi config UI lives in HelixScreen itself)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y

# Touch input (evdev-backed)
BR2_PACKAGE_TSLIB=y
BR2_PACKAGE_LIBEVDEV=y

# HTTPS for Moonraker
BR2_PACKAGE_OPENSSL=y

# HelixScreen
BR2_PACKAGE_HELIXSCREEN=y
